page{
  background-color: #2C3040;
}
.wrap{
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.bottom-wrap{
  width: 100%;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.info-card{
  background: #ffffff;
  border-radius: 20rpx;
  padding: 35rpx 30rpx;
  margin-bottom:30rpx;
  position: relative;
}
.info-row{
  font-size: 32rpx;
  color:#333;
  line-height: 64rpx;
}
.bold-text{
  font-weight: 500;
  color:#000000;
}
.arrow{
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color:#999999;
}
.start-btn{
  text-align: center;
  line-height: 88rpx;
  background-color: #1976EC;
  color:#fff;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
}
